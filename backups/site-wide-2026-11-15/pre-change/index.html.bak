    <!-- 12. FAQ (mirrors FAQPage JSON-LD in <head>) -->
    <section id="faq" class="py-16 md:py-20 bg-white" aria-labelledby="faq-heading">
        <div class="container mx-auto px-4 md:px-8 lg:px-16">

            <div class="text-center max-w-3xl mx-auto mb-12">
                <h2 id="faq-heading" class="text-2xl sm:text-3xl md:text-4xl font-bold text-blue-900 mb-4">
                    الأسئلة الشائعة عن نقل العفش في جدة
                </h2>
            </div>

            <div class="max-w-4xl mx-auto space-y-4" id="faq-accordion">
                <div class="border border-gray-200 rounded-2xl bg-gray-50 overflow-hidden">
                    <h3 class="m-0">
                        <button type="button" class="w-full text-right p-5 md:p-6 font-bold text-blue-900 text-base md:text-lg flex justify-between items-center gap-4 focus:outline-none focus:ring-2 focus:ring-blue-900" aria-expanded="false" aria-controls="faq-ans-1" onclick="toggleFaq('faq-ans-1', this)">
                            <span>كم تكلفة نقل العفش في جدة؟</span>
                            <span class="text-xl font-bold text-green-700 transform transition-transform duration-200 faq-icon" aria-hidden="true">+</span>
                        </button>
                    </h3>
                    <div id="faq-ans-1" class="hidden p-5 md:p-6 pt-0 text-gray-700 text-sm md:text-base leading-relaxed border-t border-gray-200/50 bg-white">
                        يبدأ سعر نقل العفش داخل جدة من 250 ريال، ويتحدد السعر النهائي بعد معرفة حجم الأثاث وعدد الغرف والدور ووجود المصعد والمسافة بين الموقعين والخدمات المطلوبة مثل الفك والتركيب والتغليف. نتفق معك على السعر وما يشمله قبل بدء العمل.
                    </div>
                </div>

                <div class="border border-gray-200 rounded-2xl bg-gray-50 overflow-hidden">
                    <h3 class="m-0">
                        <button type="button" class="w-full text-right p-5 md:p-6 font-bold text-blue-900 text-base md:text-lg flex justify-between items-center gap-4 focus:outline-none focus:ring-2 focus:ring-blue-900" aria-expanded="false" aria-controls="faq-ans-2" onclick="toggleFaq('faq-ans-2', this)">
                            <span>هل تشمل الخدمة فك وتركيب الأثاث؟</span>
                            <span class="text-xl font-bold text-green-700 transform transition-transform duration-200 faq-icon" aria-hidden="true">+</span>
                        </button>
                    </h3>
                    <div id="faq-ans-2" class="hidden p-5 md:p-6 pt-0 text-gray-700 text-sm md:text-base leading-relaxed border-t border-gray-200/50 bg-white">
                        نعم. يفك نجارونا غرف النوم المحلية وغرف ايكيا والدواليب السحاب والأسرة الهيدروليك والمطابخ ويعيدون تركيبها في السكن الجديد، ويتولى فنيونا فك المكيفات وإعادة تركيبها ضمن عملية النقل.
                    </div>
                </div>

                <div class="border border-gray-200 rounded-2xl bg-gray-50 overflow-hidden">
                    <h3 class="m-0">
                        <button type="button" class="w-full text-right p-5 md:p-6 font-bold text-blue-900 text-base md:text-lg flex justify-between items-center gap-4 focus:outline-none focus:ring-2 focus:ring-blue-900" aria-expanded="false" aria-controls="faq-ans-3" onclick="toggleFaq('faq-ans-3', this)">
                            <span>ما مواد التغليف التي تستخدمونها؟</span>
                            <span class="text-xl font-bold text-green-700 transform transition-transform duration-200 faq-icon" aria-hidden="true">+</span>
                        </button>
                    </h3>
                    <div id="faq-ans-3" class="hidden p-5 md:p-6 pt-0 text-gray-700 text-sm md:text-base leading-relaxed border-t border-gray-200/50 bg-white">
                        نستخدم الكرتون المقوى للأغراض الصغيرة وأدوات المطبخ، والبلاستيك الفقاعي للزجاج والشاشات والقطع الحساسة، والنايلون الاسترتش لتغليف الكنب والمراتب والأسطح الخشبية من الخدوش والغبار.
                    </div>
                </div>

                <div class="border border-gray-200 rounded-2xl bg-gray-50 overflow-hidden">
                    <h3 class="m-0">
                        <button type="button" class="w-full text-right p-5 md:p-6 font-bold text-blue-900 text-base md:text-lg flex justify-between items-center gap-4 focus:outline-none focus:ring-2 focus:ring-blue-900" aria-expanded="false" aria-controls="faq-ans-4" onclick="toggleFaq('faq-ans-4', this)">
                            <span>ماذا يحدث إذا تضررت قطعة أثناء النقل؟</span>
                            <span class="text-xl font-bold text-green-700 transform transition-transform duration-200 faq-icon" aria-hidden="true">+</span>
                        </button>
                    </h3>
                    <div id="faq-ans-4" class="hidden p-5 md:p-6 pt-0 text-gray-700 text-sm md:text-base leading-relaxed border-t border-gray-200/50 bg-white">
                        نتعامل مع المنقولات بعناية في كل مرحلة، ونلتزم بالتعويض عن أي ضرر ناتج عن عملية النقل. ننصحك بمراجعة القطع مع المشرف عند التسليم وإبلاغنا بأي ملاحظة فوراً.
                    </div>
                </div>

