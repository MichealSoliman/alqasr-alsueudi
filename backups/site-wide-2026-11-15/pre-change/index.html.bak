      "primaryImageOfPage": { "@type": "ImageObject", "url": "https://alqasr-alsueudi.com/assets/img/work/og-furniture-moving-jeddah.jpg" },
      "dateModified": "2026-11-15"
    },
    {
      "@type": "FAQPage",
      "@id": "https://alqasr-alsueudi.com/#faq",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "كم تكلفة نقل العفش في جدة؟",
          "acceptedAnswer": { "@type": "Answer", "text": "يبدأ سعر نقل العفش داخل جدة من 250 ريال، ويتحدد السعر النهائي بعد معرفة حجم الأثاث وعدد الغرف والدور ووجود المصعد والمسافة بين الموقعين والخدمات المطلوبة مثل الفك والتركيب والتغليف. نتفق معك على السعر وما يشمله قبل بدء العمل." }
        },
        {
          "@type": "Question",
          "name": "هل تشمل الخدمة فك وتركيب الأثاث؟",
          "acceptedAnswer": { "@type": "Answer", "text": "نعم. يفك نجارونا غرف النوم المحلية وغرف ايكيا والدواليب السحاب والأسرة الهيدروليك والمطابخ ويعيدون تركيبها في السكن الجديد، ويتولى فنيونا فك المكيفات وإعادة تركيبها ضمن عملية النقل." }
        },
        {
          "@type": "Question",
          "name": "ما مواد التغليف التي تستخدمونها؟",
          "acceptedAnswer": { "@type": "Answer", "text": "نستخدم الكرتون المقوى للأغراض الصغيرة وأدوات المطبخ، والبلاستيك الفقاعي للزجاج والشاشات والقطع الحساسة، والنايلون الاسترتش لتغليف الكنب والمراتب والأسطح الخشبية من الخدوش والغبار." }
        },
        {
          "@type": "Question",
          "name": "ماذا يحدث إذا تضررت قطعة أثناء النقل؟",
          "acceptedAnswer": { "@type": "Answer", "text": "نتعامل مع المنقولات بعناية في كل مرحلة، ونلتزم بالتعويض عن أي ضرر ناتج عن عملية النقل. ننصحك بمراجعة القطع مع المشرف عند التسليم وإبلاغنا بأي ملاحظة فوراً." }
        },
        {
          "@type": "Question",
          "name": "هل تنقلون الفلل والمكاتب والشركات؟",
          "acceptedAnswer": { "@type": "Answer", "text": "نعم. نقل الفلل يحتاج غالباً أكثر من دينا وطاقم أكبر ويُخطط له بعد المعاينة، أما نقل المكاتب فيشمل تغليف الأجهزة وترقيم الملفات والأرشيف وفك المكاتب وتركيبها بحيث يعود العمل في أسرع وقت." }
        },
        {
          "@type": "Question",
          "name": "متى أحتاج ونش رفع الأثاث؟",
          "acceptedAnswer": { "@type": "Answer", "text": "يُستخدم ونش الرفع الهيدروليكي عندما تكون السلالم ضيقة أو المصعد لا يتسع للقطع الكبيرة مثل الكنب والدواليب وغرف النوم، فيتم تنزيلها أو رفعها من الشباك أو البلكونة. نحدد الحاجة إليه أثناء المعاينة." }
        },
        {
          "@type": "Question",
          "name": "هل تغطون جميع أحياء جدة؟",
          "acceptedAnswer": { "@type": "Answer", "text": "نعم، ننفذ النقل في أحياء شمال وجنوب وشرق ووسط جدة، وننقل العفش كذلك من جدة إلى مدن المملكة مثل مكة المكرمة والمدينة المنورة والرياض والدمام." }
        },
        {
          "@type": "Question",
          "name": "هل توفرون تخزين الأثاث؟",
          "acceptedAnswer": { "@type": "Answer", "text": "نعم، نوفر تخزين الأثاث في مستودعات جافة ومغلقة ومؤمنة لفترات قصيرة أو طويلة، مع تغليف القطع قبل التخزين وتخصيص مساحة لكل عميل. يبدأ التخزين الشهري من 250 ريال حسب المساحة والمدة." }
        },
        {
          "@type": "Question",
          "name": "هل يمكن نقل العفش في نفس اليوم؟",
          "acceptedAnswer": { "@type": "Answer", "text": "نستقبل الطلبات على مدار الساعة عبر الاتصال أو الواتساب، وإمكانية التنفيذ في نفس اليوم تعتمد على توفر الفريق والسيارات في الموعد المطلوب، لذلك ننصح بالحجز قبل موعد النقل بيوم أو يومين." }
        },
        {
          "@type": "Question",
          "name": "ما الفرق بين نقل العفش داخل جدة ونقله إلى مدينة أخرى؟",
          "acceptedAnswer": { "@type": "Answer", "text": "النقل داخل جدة يتم عادة في يوم واحد ويُحسب حسب حجم الأثاث والدور والخدمات. أما النقل إلى مدينة أخرى فيحتاج تغليفاً أقوى يتحمل الطريق الطويل، ويُحدد سعره حسب الوجهة وحجم المنقولات ونوع الشاحنة." }
        },
        {
          "@type": "Question",
          "name": "كيف أختار شركة نقل عفش موثوقة في جدة؟",
          "acceptedAnswer": { "@type": "Answer", "text": "اطلب عرض سعر واضحاً يحدد ما يشمله قبل التنفيذ، وتأكد أن الشركة تستخدم سيارات مقفلة وتوفر نجارين للفك والتركيب، واسأل عن طريقة التعامل مع أي ضرر قبل الحجز، واطلع على صور من أعمالها وآراء عملائها." }
        }
      ]
    }
  ]
}
</script>
