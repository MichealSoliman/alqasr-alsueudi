    <!-- Main JavaScript -->
    <script src="/assets/js/main.js" defer=""></script>
    <!-- navbar.js removed from this page: it currently throws "Identifier 'desktopDropdownGroup' has already been declared"
         and never executes; main.js handles the mobile menu. Re-add once navbar.js is fixed site-wide (see audit/13-homepage-recovery-report.md). -->
    <script>
        function toggleFaq(ansId, btn) {
            const ans = document.getElementById(ansId);
            if (!ans) return;
            const isHidden = ans.classList.contains('hidden');
            ans.classList.toggle('hidden');
            btn.setAttribute('aria-expanded', isHidden ? 'true' : 'false');
            const icon = btn.querySelector('.faq-icon');
            if (icon) {
                icon.textContent = isHidden ? '−' : '+';
            }
        }
    </script>
